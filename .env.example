# Provisional placeholders; no application reads these yet.
# Copy to .env when needed and supply local values. Never commit real secrets.

# Frontend: public backend API URL (public variables must not contain secrets)
NEXT_PUBLIC_API_BASE_URL=

# Backend: Spring Boot HTTP port
SERVER_PORT=

# Backend: PostgreSQL JDBC connection and credentials
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Backend only: OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=
